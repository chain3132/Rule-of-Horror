  m_Script: {fileID: 11500000, guid: 41317668c27ad3e4eb2364064ad2ed14, type: 3}
  m_Name: Rule6
  m_EditorClassIdentifier: Assembly-CSharp::ScriptableObject.ConversationData
  serializationData:
    SerializedFormat: 2
    SerializedBytes:
