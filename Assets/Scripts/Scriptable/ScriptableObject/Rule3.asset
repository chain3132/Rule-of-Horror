  nodes:
  - message: Next rule, rule number 3
    isPlayer: 0
    replies: []
    nextNode: 1
  - message: You have to find four pieces of paper with numbers on them
    isPlayer: 0
    replies: []
    nextNode: 2
  - message: ' You have to stare at them until the numbers disappear, in ascending
