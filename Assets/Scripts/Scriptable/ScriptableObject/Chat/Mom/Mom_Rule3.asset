    offersReward: 0
    replies: []
    nextNode: 5
    recordsRule: {fileID: 0}
    recordsAsCooperative: 1
    graphPosition: {x: 900, y: 0}
  - message: Which shed, sweetheart? Stay calm, and don't move from there.
