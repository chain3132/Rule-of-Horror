  m_Name: RuleEntry_6
  m_EditorClassIdentifier: Assembly-CSharp::ScriptableObject.RuleEntryData
  ruleNumber: 6
  title: The Bus
  summary: A bus will stop in front of the pavilion. Read it before you stand up
    - you only get on one
  startHour: 24
  startMinute: 0
  endHour: 24
  endMinute: 40
  factSlots: 4
  factsIfCooperative:
  - Stay seated. A bus will come to you
  - Get up to check a bus and it will wait as long as you like
  - Sit back down and it moves on to the next one
  - Take the one with people in it. An empty bus at this hour is not a bus
  factsIfDefiant:
  - Get on a bus
  hands: []
