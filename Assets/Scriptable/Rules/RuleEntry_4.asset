  m_Script: {fileID: 11500000, guid: d45dcf287c33007408283061f0a39fc8, type: 3}
  m_Name: RuleEntry_4
  m_EditorClassIdentifier: Assembly-CSharp::ScriptableObject.RuleEntryData
  ruleNumber: 4
  title: Offering
  summary: Find the dolls, then place them on the pavilion
  startHour: 22
  startMinute: 0
  endHour: 22
  endMinute: 40
  factSlots: 5
  factsIfCooperative:
  - Search for dolls by sound. The closer you are, the clearer it gets
  - You must place a total of 6 dolls
  - The pavilion is not always in the same place
  - If the hanged person disappears, do not let them hear you holding your breath
  - If it finds you, do not run. Stare at it
  factsIfDefiant:
  - Dolls must be returned to the pavilion
  hands:
  - key: E
    action: Pick up / Place doll
  - key: Hold Right-Click
    action: Stare
  - key: Hold Q
    action: Hold breath
