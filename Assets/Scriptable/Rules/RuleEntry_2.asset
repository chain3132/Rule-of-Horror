MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d45dcf287c33007408283061f0a39fc8, type: 3}
  m_Name: RuleEntry_2
  m_EditorClassIdentifier: Assembly-CSharp::ScriptableObject.RuleEntryData
  ruleNumber: 2
  title: Blackout
  summary: The power is out. Get up to turn the light back on, turn on the radio
    before returning, and sit in your original seat until the radio stops
  startHour: 20
  startMinute: 0
  endHour: 20
  endMinute: 40
  factSlots: 3
  factsIfCooperative:
  - Turn on the light, then turn on the radio
  - Return to your original seat and wait until the radio turns off
  - If the light doesn't turn on, you must go fix it yourself
  factsIfDefiant:
  - Turn on the light, then turn on the radio
  - Return to your original seat and wait until the radio turns off
  hands:
  - key: E
    action: Turn on light / Turn on radio / Open fuse box
  - key: Mouse
    action: Pull lever in fuse box
  - key: 2
    action: Flashlight
