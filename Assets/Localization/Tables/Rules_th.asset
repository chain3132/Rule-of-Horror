    m_Localized: "\u0E16\u0E49\u0E32\u200B\u0E04\u0E19\u200B\u0E17\u0E35\u0E48\u200B\u0E41\u0E02\u0E27\u0E19\u200B\u0E04\u0E2D\u200B\u0E2D\u0E22\u0E39\u0E48\u200B\u0E2B\u0E32\u0E22\u0E44\u0E1B
