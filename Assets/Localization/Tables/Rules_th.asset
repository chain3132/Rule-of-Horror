    m_Localized: "\u0E15\u0E38\u0E4A\u0E01\u0E15\u0E32\u200B\u0E15\u0E49\u0E2D\u0E07\u200B\u0E16\u0E39\u0E01\u200B\u0E19\u0E33\u200B\u0E01\u0E25\u0E31\u0E1A\u0E44\u0E1B\u200B\u0E17\u0E35\u0E48\u200B\u0E28\u0E32\u0E25"
