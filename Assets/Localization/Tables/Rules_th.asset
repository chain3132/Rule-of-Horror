    m_Localized: "\u0E17\u0E33\u200B\u0E15\u0E32\u0E21\u200B\u0E01\u0E0E\u200B\u0E41\u0E25\u0E49\u0E27\u200B\u0E23\u0E2D\u200B\u0E08\u0E19\u0E01\u0E27\u0E48\u0E32\u200B\u0E08\u0E30\u200B\u0E16\u0E36\u0E07\u200B\u0E40\u0E27\u0E25\u0E32"
