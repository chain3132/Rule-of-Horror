    m_Localized: "\u0E40\u0E21\u0E37\u0E48\u0E2D\u200B\u0E2A\u0E32\u0E22\u0E2A\u0E34\u0E0D\u0E08\u0E19\u0E4C\u200B\u0E25\u0E49\u0E2D\u0E21\u200B\u0E23\u0E2D\u0E1A\u200B\u0E28\u0E32\u0E25\u0E32
