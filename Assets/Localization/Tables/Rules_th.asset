    m_Localized: "\u0E14\u0E36\u0E07\u200B\u0E04\u0E31\u0E19\u0E42\u0E22\u0E01\u200B\u0E43\u0E19\u200B\u0E15\u0E39\u0E49\u200B\u0E44\u0E1F"
