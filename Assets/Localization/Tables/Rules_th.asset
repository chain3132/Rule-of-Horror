    m_Localized: "\u0E15\u0E49\u0E2D\u0E07\u200B\u0E27\u0E32\u0E07\u200B\u0E15\u0E38\u0E4A\u0E01\u0E15\u0E32\u200B\u0E43\u0E2B\u0E49\u200B\u0E04\u0E23\u0E1A
