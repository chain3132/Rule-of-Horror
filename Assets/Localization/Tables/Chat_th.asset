    m_Localized: "\u0E25\u0E38\u0E07\u0E1A\u0E2D\u0E01\u0E27\u0E48\u0E32\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E01\u0E48\u0E2D\u0E19\u0E21\u0E35\u0E1C\u0E39\u0E49\u0E2B\u0E0D\u0E34\u0E07\u0E04\u0E19\u0E19\u0E36\u0E07\u0E44\u0E1B\u0E23\u0E2D\u0E23\u0E16\u0E17\u0E35\u0E48\u0E28\u0E32\u0E25\u0E32\u0E19\u0E31\u0E49\u0E19"
