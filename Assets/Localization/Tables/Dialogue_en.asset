  m_TableData:
  - m_Id: 939167744
    m_Localized: Whew, took long enough! If the usual waiting spot hadn't been wrecked
      in the storm, I would have reached home to see my mom ages ago
    m_Metadata:
      m_Items: []
  - m_Id: 955944960
    m_Localized: "Ehh What\u2019s happening? Something feels weird here"
    m_Metadata:
      m_Items: []
  - m_Id: 955944961
    m_Localized: Wait... Where's my phone !!
    m_Metadata:
      m_Items: []
  - m_Id: 955944962
    m_Localized: and What the hell was that message about?
    m_Metadata:
      m_Items: []
  - m_Id: 955944963
    m_Localized: I have to find my phone first
    m_Metadata:
      m_Items: []
